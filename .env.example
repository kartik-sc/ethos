# Copy to .env and fill in. Never commit .env.

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Asia/Kolkata

# PostgreSQL (compose). POSTGRES_PORT is the host port published by the dev override.
POSTGRES_USER=ethos
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=ethos
POSTGRES_PORT=5433

# Backend run on the host uses the published port. Compose overrides DATABASE_URL
# to reach the internal `db` host.
DATABASE_URL=postgresql+psycopg://ethos:change-me-locally@127.0.0.1:5433/ethos
TEST_DATABASE_URL=postgresql+psycopg://ethos:change-me-locally@127.0.0.1:5433/ethos_test
WORKER_HEARTBEAT_SECONDS=30
# Uploaded project files (host-run backend). Compose uses the `files` volume.
FILE_STORAGE_DIR=data/files

# Caddy. In production set SITE_ADDRESS to the domain (Caddy provisions HTTPS)
# and HTTP_PORT/HTTPS_PORT to 80/443.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
